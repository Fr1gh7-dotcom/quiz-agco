# Supabase — copia in .env.local e riempi con le tue chiavi
# Dashboard Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL pubblico del quiz (usato dallo script QR). Es: https://quiz-agco.vercel.app
QUIZ_URL=https://quiz-agco.example.com

# Pexels (solo build-time, per scaricare le foto delle slide)
PEXELS_API_KEY=xxxxx
